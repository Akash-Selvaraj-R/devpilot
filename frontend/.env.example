# DevPilot Frontend Environment Variables
# Copy this to .env.local for local development (optional)
# For Vercel, set these in the Vercel dashboard under Settings > Environment Variables

# The backend API URL. In development, leave unset to use Vite's dev proxy.
# In production (Vercel), set to your Render backend URL WITHOUT a trailing slash.
# Example: VITE_API_URL=https://devpilot-backend-9ts3.onrender.com/api
VITE_API_URL=
